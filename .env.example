# Browser-safe Supabase project values. The anon/publishable key is not a
# service-role key; authorization is enforced by Supabase RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: full API URL for deployments where the frontend and Express API
# are hosted on separate origins. Leave blank for same-origin /api routing.
VITE_API_BASE_URL=

# API server values; set the same Supabase URL and anon key for the API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
ALLOWED_ORIGINS=http://localhost:5173
