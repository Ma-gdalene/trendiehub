{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "buildCommand": "pnpm --filter @workspace/api-server run build",
      "outputDirectory": "dist"
    },
    "trendie-models": {
      "root": "artifacts/trendie-models",
      "framework": "vite",
      "buildCommand": "pnpm --filter @workspace/trendie-models run build",
      "outputDirectory": "dist/public"
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html|/|$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "trendie-models"
      }
    },
    {
      "source": "/(.*\\..*)",
      "destination": {
        "service": "trendie-models"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "trendie-models",
        "path": "/index.html"
      }
    }
  ]
}
