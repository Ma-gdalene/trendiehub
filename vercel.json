{
  "buildCommand": "pnpm --filter @workspace/trendie-models run build",
  "outputDirectory": "artifacts/trendie-models/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
