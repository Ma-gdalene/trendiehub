{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "buildCommand": "pnpm --filter @workspace/api-server run build",
      "outputDirectory": "dist"
    },
    "trendie-models": {
      "root": "artifacts/trendie-models",
      "framework": "vite",
      "buildCommand": "pnpm --filter @workspace/trendie-models run build",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "trendie-models"
      }
    }
  ]
}
