# ─────────────────────────────────────────────────
# TRENDIE MODELS · Supabase Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your Supabase
# project credentials. You can find these in your
# Supabase dashboard → Settings → API.
# ─────────────────────────────────────────────────

# Frontend (Vite) — exposed to the browser
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend (API server) — server-side only
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: API base URL (defaults to /api in production)
# VITE_API_BASE_URL=http://localhost:5000

# Optional: Allowed CORS origins for the API server
# ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app
